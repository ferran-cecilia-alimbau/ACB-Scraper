[Unit]
Description=ACB Scraper daily data update
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/acb-scraper
Environment=TZ=Europe/Madrid
ExecStart=/usr/bin/flock -n /tmp/acb-scraper.lock /usr/bin/docker compose run --rm scraper python scripts/update_all.py --verify-pbp
TimeoutStartSec=12h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
